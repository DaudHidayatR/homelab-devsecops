# DevSecOps Lab Template Configuration
# Source this file in setup scripts or consume via Kustomize configMapGenerator.
# All cluster-level constants are centralized here to eliminate duplication
# between shell scripts and Kubernetes manifests.
#
# Copy this file to config.env and customize values for your environment:
#   cp config.env.example config.env

# --- Flux GitOps ---
# Set both to bootstrap Flux CD from GitHub. Leave empty to skip GitOps.
# Get a token: https://github.com/settings/tokens (repo scope required)
GITHUB_USER=""
GITHUB_TOKEN=""
FLUX_GITHUB_REPOSITORY="homelab-devsecops"
FLUX_GITHUB_BRANCH="main"
FLUX_CLUSTER_PATH="./kubernetes/clusters/homelab"
# auto: reuse installed Flux or committed flux-system manifests; never push.
# github: allow flux bootstrap github to push directly to FLUX_GITHUB_BRANCH.
FLUX_BOOTSTRAP_MODE="auto"

# --- Flux Deployment Mode (branch-main, decision 2026-08-31) ---
# Flux watches the repository main branch; every signed merge to main is
# reconciled automatically. There is no tag-based deployment selector and no
# runtime ref switching in this repository.

# --- Cluster ---
CLUSTER_NAME="your-cluster-name"

# --- Namespaces ---
DEMO_NAMESPACE="demo"
OPENBAO_NAMESPACE="openbao"
HEADLAMP_NAMESPACE="headlamp"

# --- OpenBao ---
OPENBAO_POD="openbao-0"
OPENBAO_ADDR="http://127.0.0.1:8200"
OPENBAO_BACKUP_DIR=".runtime-backups/openbao"
OPENBAO_CREATE_DEFAULT_ADMIN="false"
OPENBAO_CREATE_DEFAULT_APPROLE="false"

# --- Headlamp ---
# Pinned to a specific release for reproducible deployments.
# Upgrade path: change HEADLAMP_VERSION and re-run setup.
HEADLAMP_IMAGE="ghcr.io/headlamp-k8s/headlamp"
HEADLAMP_VERSION="v0.30.0"


# --- Sample Application ---
# Pinned to a specific nginx stable release for reproducible deployments.
SAMPLE_APP_IMAGE="nginx:1.30.1-alpine"

# --- Tailscale Operator ---
# Set both to auto-install the Tailscale Kubernetes Operator during setup.
# Leave empty to skip Tailscale installation (manual port-forward access only).
# Get credentials: https://login.tailscale.com/admin/settings/oauth
# Required scope: Devices → Write
TAILSCALE_CLIENT_ID=""
TAILSCALE_CLIENT_SECRET=""
TAILSCALE_OPERATOR_VERSION="v1.96.4"
TAILSCALE_NAMESPACE="tailscale"
TAILSCALE_BACKUP_DIR=".runtime-backups/tailscale"
TAILSCALE_TAILNET_DOMAIN=""
# Optional space-separated host[:path] overrides for scripts/homelab tailscale check.
# Example: "openbao-openbao.example.ts.net:/ui/ kube-system-headlamp.example.ts.net:/"
TAILSCALE_ACCESS_HOSTS=""

# --- Tailscale VPS Host (for CI/CD deploy) ---
# The hostname of the VPS running the kind cluster, as registered in Tailscale.
# Used in kubeconfig generation and certSANs in the cluster's kind configuration for CI/CD access.
# Run 'tailscale status' on the VPS to find its hostname and IP.
TAILSCALE_VPS_HOSTNAME=""
TAILSCALE_VPS_IP=""

# Optional scanner runtime controls.
# SCAN_ROOT defaults to this infra/kind directory. Set it to scan another repo.
# SCAN_OUTPUT defaults to this infra/kind directory. Set it to keep reports elsewhere.
# SCAN_RUNTIME_ARGS is appended to docker/podman run, useful for DNS/proxy fixes.
# Example: SCAN_RUNTIME_ARGS="--dns 1.1.1.1"
# SCAN_ROOT=""
# SCAN_OUTPUT=""
# SCAN_RUNTIME_ARGS=""

# --- Security Scanner Images ---
# Used by scripts/homelab security scan and Makefile security targets.
TRIVY_IMAGE="ghcr.io/aquasecurity/trivy:0.70.0"
GRYPE_IMAGE="docker.io/anchore/grype:v0.85.0"
GITLEAKS_IMAGE="docker.io/zricethezav/gitleaks:v8.24.0"
SEMGREP_IMAGE="docker.io/semgrep/semgrep:1.99.0"
CHECKOV_IMAGE="docker.io/bridgecrew/checkov:3.2.473"
SYFT_IMAGE="docker.io/anchore/syft:v1.18.1"
SEVERITY="HIGH,CRITICAL"
