trivy-report.*
trivy-rendered.*
grype-report.*
gitleaks-report.*
semgrep-report.*
sbom-*.json
# Temporary rendered manifest used for scanning
.rendered-manifests.yaml
wiki/*
raw/*
plans/*
docs/plans/*
docs/openbao-integration.md
apps/rabbitmq/core/secret.yaml
.commandcode

# Runtime backups may contain Tailscale machine keys and OAuth secrets
.runtime-backups/
